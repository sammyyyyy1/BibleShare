<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Copy this file to Secrets.plist (same folder) and fill in your values.
	     Secrets.plist is git-ignored; this .example template is committed.
	     Find these in the Supabase dashboard: Project Settings > API. -->
	<key>SUPABASE_URL</key>
	<string>https://YOUR-PROJECT-REF.supabase.co</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>YOUR-ANON-PUBLIC-KEY</string>
</dict>
</plist>
